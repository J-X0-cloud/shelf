# Canonical site URL (metadata, appcast links).
NEXT_PUBLIC_SITE_URL=https://shelfapp.com

# Where signed .dmg builds are hosted. Files are named Shelf-<version>.dmg.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=https://downloads.shelfapp.com

# Hosted checkout links per license.
CHECKOUT_URL_PERSONAL=
CHECKOUT_URL_FAMILY=
CHECKOUT_URL_TEAM=

# Transactional email for license recovery. Emails are logged to the console when unset.
MAIL_API_URL=
MAIL_API_KEY=
