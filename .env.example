# Copy to .env for local runs (`set -a; . ./.env; set +a`), or set these on the host.

# Port the server listens on. Railway and most hosts set this for you.
PORT=8080

# Canonical site URL (metadata, canonical links, appcast links).
SITE_URL=https://shelfapp.com

# Where signed .dmg builds are hosted. Files are named Shelf-<version>.dmg.
DOWNLOAD_BASE_URL=https://downloads.shelfapp.com

# Hosted checkout links per license. Plans without one send buyers back to /pricing.
CHECKOUT_URL_PERSONAL=
CHECKOUT_URL_FAMILY=
CHECKOUT_URL_TEAM=

# Transactional email for license recovery. Emails are logged (without the keys) when unset.
MAIL_API_URL=
MAIL_API_KEY=

# Folder with templates/ and public/. The Docker image sets this; locally it is ./site.
SITE_ROOT=site

# trace, debug, info, notice, warning, error or critical.
LOG_LEVEL=info
